const { EcoSDK } = require("./ecosdk");

// =========================================================================
// SANS SDK (approche verbeuse et sujette aux erreurs) — conservé pour comparer
// =========================================================================
const API_KEY = "mch_live_99x821a";
const API_URL = "http://localhost:8000/v1/events/purchase";

async function simulatePurchaseWithoutSDK() {
  const payload = {
    orderId: "ORD-" + Math.floor(Math.random() * 10000),
    items: [
      { category: "electronics", weightKg: 1.5 },
      { category: "clothing", weightKg: 0.8 },
    ],
  };

  try {
    const response = await fetch(API_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-API-Key": API_KEY },
      body: JSON.stringify(payload),
    });
    const data = await response.json();
    console.log("[Sans SDK] Réponse de l'API :", data);
  } catch (error) {
    console.error("[Sans SDK] Erreur :", error);
  }
}

// =========================================================================
// AVEC SDK : 3 lignes utiles
// =========================================================================
async function simulatePurchaseWithSDK() {
  const eco = new EcoSDK({ apiKey: "mch_live_99x821a" });

  const result = await eco.trackPurchase({
    orderId: "ORD-" + Math.floor(Math.random() * 10000),
    items: [{ category: "electronics", weightKg: 1.5 }],
  });
  console.log("[Avec SDK] Réponse :", result);

  // Mode non bloquant : ne ralentit pas le tunnel de commande
  eco.trackPurchaseAsync({
    orderId: "ORD-" + Math.floor(Math.random() * 10000),
    items: [{ category: "food", weightKg: 2 }],
  });

  await new Promise((r) => setTimeout(r, 300)); // laisse partir l'envoi async
  console.log("[Avec SDK] Analytics :", await eco.getAnalytics());

  // Clé invalide : erreur claire, pas de retry inutile
  try {
    await new EcoSDK({ apiKey: "mauvaise_cle" }).trackPurchase({
      orderId: "X",
      items: [{ category: "food", weightKg: 1 }],
    });
  } catch (e) {
    console.log("[Avec SDK] Erreur attendue :", e.name, "-", e.message);
  }
}

(async () => {
  await simulatePurchaseWithoutSDK();
  await simulatePurchaseWithSDK();
})();
